---
const { sunflower = false, autoPlay = false, repel = false } = Astro.props;
const letters = [..."people"];
const lifts = [-0.08, -0.22, -0.32, -0.2, 0.06, 0.18];
const tilts = [-4, 3, -2, 3.5, -2.5, 4];
---

<button
  class="people-bloom"
  type="button"
  aria-label="Animate the word people"
  aria-pressed="false"
  data-people-bloom
  data-auto-play={autoPlay ? "true" : undefined}
  data-repel={repel ? "true" : undefined}
>
  <span class="word" aria-hidden="true">
    {letters.map((letter, index) => (
      <span
        class:list={["letter", { "letter--sunflower": sunflower && index === 2 }]}
        style={`--i:${index}; --lift:${lifts[index]}em; --tilt:${tilts[index]}deg;`}
      >
        {sunflower && index === 2 ? (
          <span class="landing-sun">
            <svg viewBox="0 0 32 32">
              <defs>
                <radialGradient id="people-sunflower" cx="35%" cy="30%">
                  <stop offset="0" stop-color="#ffcc73" />
                  <stop offset="0.3" stop-color="#ffcc73" />
                  <stop offset="0.62" stop-color="#ffaa00" />
                  <stop offset="1" stop-color="#ffaa00" />
                </radialGradient>
              </defs>
              <g class="sunflower-petals">
                <ellipse cx="16" cy="6.1" rx="2.2" ry="4.1" />
                <ellipse cx="16" cy="6.4" rx="2" ry="3.8" transform="rotate(38 16 16)" />
                <ellipse cx="16" cy="6" rx="2.3" ry="4.2" transform="rotate(76 16 16)" />
                <ellipse cx="16" cy="6.5" rx="2" ry="3.7" transform="rotate(114 16 16)" />
                <ellipse cx="16" cy="6.2" rx="2.2" ry="4" transform="rotate(152 16 16)" />
                <ellipse cx="16" cy="6.4" rx="2" ry="3.8" transform="rotate(190 16 16)" />
                <ellipse cx="16" cy="6" rx="2.3" ry="4.2" transform="rotate(228 16 16)" />
                <ellipse cx="16" cy="6.5" rx="2" ry="3.7" transform="rotate(266 16 16)" />
                <ellipse cx="16" cy="6.2" rx="2.2" ry="4" transform="rotate(304 16 16)" />
                <ellipse cx="16" cy="6.4" rx="2" ry="3.8" transform="rotate(342 16 16)" />
              </g>
              <circle class="sun-core" cx="16" cy="16" r="7.4" fill="url(#people-sunflower)" />
            </svg>
          </span>
        ) : letter}
      </span>
    ))}
  </span>
</button>

<script>
  const peopleBloomControls = document.querySelectorAll<HTMLButtonElement>("[data-people-bloom]");

  peopleBloomControls.forEach((control) => {
    const setActive = (active: boolean) => {
      control.classList.toggle("is-active", active);
      control.setAttribute("aria-pressed", String(active));
    };

    control.onclick = () => {
      const willActivate = !control.classList.contains("is-active");
      peopleBloomControls.forEach((item) => {
        item.classList.remove("is-active");
        item.setAttribute("aria-pressed", "false");
      });
      setActive(willActivate);
    };

    if (control.dataset.autoPlay === "true" && control.dataset.autoPlayed !== "true") {
      control.dataset.autoPlayed = "true";
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => {
          setActive(true);
          window.setTimeout(() => {
            setActive(false);
          }, 750);
        });
      });
    }

    if (control.dataset.repel === "true") {
      const letters = Array.from(control.querySelectorAll<HTMLElement>(".letter"));
      const resetLetters = () => {
        letters.forEach((letter) => {
          letter.style.removeProperty("--repel-x");
          letter.style.removeProperty("--repel-y");
          letter.style.removeProperty("--repel-rotate");
        });
      };

      control.onpointermove = (event) => {
        letters.forEach((letter) => {
          const bounds = letter.getBoundingClientRect();
          const centerX = bounds.left + bounds.width / 2;
          const centerY = bounds.top + bounds.height / 2;
          const deltaX = centerX - event.clientX;
          const deltaY = centerY - event.clientY;
          const distance = Math.max(Math.hypot(deltaX, deltaY), 1);
          const influence = Math.max(0, 1 - distance / 110);
          const force = influence * 13;

          letter.style.setProperty("--repel-x", `${(deltaX / distance) * force}px`);
          letter.style.setProperty("--repel-y", `${(deltaY / distance) * force}px`);
          letter.style.setProperty("--repel-rotate", `${(deltaX / distance) * influence * 5}deg`);
        });
      };
      control.onpointerleave = resetLetters;
      control.onblur = resetLetters;
    }
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element) || event.target.closest("[data-people-bloom]")) return;
    peopleBloomControls.forEach((control) => {
      control.classList.remove("is-active");
      control.setAttribute("aria-pressed", "false");
    });
  });
</script>

<style>
  .people-bloom {
    position: relative;
    z-index: 0;
    display: inline-block;
    margin: 0;
    padding: 0 0.03em 0.08em;
    border: 0;
    border-radius: 0;
    background: none;
    color: var(--red);
    font: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    vertical-align: baseline;
    cursor: inherit;
    isolation: isolate;
  }

  .people-bloom:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 0.16em;
    border-radius: 0.08em;
  }

  .word,
  .letter {
    display: inline-block;
  }

  .letter--sunflower {
    width: 0.82em;
  }

  .landing-sun {
    display: inline-block;
    width: 0.86em;
    height: 0.86em;
    margin-left: -0.05em;
    vertical-align: -0.23em;
    animation: sunflower-bounce 5.2s ease-in-out infinite;
  }

  .landing-sun svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: brightness(0.95) drop-shadow(0 0 3px rgba(255, 170, 0, 0.5));
    transition: transform 500ms ease;
  }

  .sunflower-petals {
    fill: #f7c948;
    opacity: 0.78;
  }

  .people-bloom:not([data-repel="true"]):hover .landing-sun svg,
  .people-bloom:focus-visible .landing-sun svg,
  .people-bloom.is-active .landing-sun svg {
    transform: rotate(8deg) scale(1.04);
  }

  .letter {
    --repel-x: 0px;
    --repel-y: 0px;
    --repel-rotate: 0deg;
    transform-origin: center bottom;
    transition:
      color 250ms ease,
      transform 560ms cubic-bezier(0.18, 0.9, 0.25, 1.3);
    transition-delay: calc(var(--i) * 55ms);
  }

  .people-bloom:not([data-repel="true"]):hover .letter,
  .people-bloom:focus-visible .letter,
  .people-bloom.is-active .letter {
    color: var(--red);
    transform: translateY(var(--lift)) rotate(var(--tilt));
  }

  .people-bloom[data-repel="true"] .letter {
    transform: translate(var(--repel-x), var(--repel-y)) rotate(var(--repel-rotate));
    transition: transform 120ms ease-out;
    transition-delay: 0ms;
  }

  .people-bloom[data-repel="true"].is-active .letter {
    transform: translateY(var(--lift)) rotate(var(--tilt));
    transition: transform 280ms cubic-bezier(0.18, 0.9, 0.25, 1.3);
    transition-delay: calc(var(--i) * 27.5ms);
  }

  @keyframes sunflower-bounce {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -0.035em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .people-bloom * {
      transition-duration: 0.01ms !important;
      transition-delay: 0ms !important;
    }

    .people-bloom:not([data-repel="true"]):hover .letter,
    .people-bloom:focus-visible .letter,
    .people-bloom.is-active .letter,
    .people-bloom[data-repel="true"] .letter {
      transform: none;
    }

    .landing-sun {
      animation: none;
    }
  }
</style>
