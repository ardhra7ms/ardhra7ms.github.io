---
import Base from "../layouts/Base.astro";
import PeopleBloom from "../components/PeopleBloom.astro";
---
<Base bg bodyClass="home">
  <section class="hero">
    <p class="kicker"><span class="ink">Content Designer</span> → Content Strategist</p>
    <h1>
      I make products talk the way <PeopleBloom sunflower repel /> do.
    </h1>
    <p
      class="subtitle"
      data-typewriter
      data-copy="I'm on a quest to scale content systems for AI-forward product design."
      aria-label="People are dynamic, and so is language. I'm on a quest to scale content systems for AI-forward product design."
    >
      <span class="subtitle-static">People are dynamic, and so is language.</span>{" "}
      <span class="subtitle-typed" data-typewriter-output aria-hidden="true"></span>
    </p>
    <p class="muted lede">
      I'm a writer, artist, and lover of languages, trained in communications, digital media, and engineering. I build <span class="em" tabindex="0">content systems</span> that scale across complex product ecosystems by establishing <span class="em" tabindex="0">terminology</span>, defining <span class="em" tabindex="0">objects</span> and <span class="em" tabindex="0">relationships</span>, and mapping them to product truth.<span class="cursor" aria-hidden="true"></span>
    </p>
  </section>

  <section class="paths">
    <a class="path" href="/story" data-index="01">
      <span class="path-title">H<span class="coin-letter">o</span>w I see</span>
      <span class="path-copy">
        <span class="path-sub">The stories that shape me and how I make sense of the world.</span>
        <span class="path-cta">story →</span>
      </span>
    </a>
    <a class="path" href="/work" data-index="02">
      <span class="path-title">What I d<span class="coin-letter">o</span></span>
      <span class="path-copy">
        <span class="path-sub">Where work leads to passion and inspiration finds me.</span>
        <span class="path-cta">work →</span>
      </span>
    </a>
  </section>

  <p class="skills-note">
    <span class="note-firefly" aria-hidden="true"><span class="note-glow"></span></span>A person is a growing tree, and <a href="/skills">skills</a> are guiding fireflies.
  </p>

  <script>
    const requestedNavStyle = new URLSearchParams(window.location.search).get("nav");
    const navStyle =
      requestedNavStyle === "boxes" ||
      requestedNavStyle === "branches" ||
      requestedNavStyle === "editorial" ||
      requestedNavStyle === "growth" ||
      requestedNavStyle === "constellation" ||
      requestedNavStyle === "sentences"
        ? requestedNavStyle
        : "constellation";
    document.documentElement.dataset.homeNav = navStyle;
    const containerStyle = new URLSearchParams(window.location.search).get("container");
    document.documentElement.dataset.seesawContainer =
      containerStyle === "pans" || containerStyle === "none"
        ? containerStyle
        : "placards";
    const seesaw = document.querySelector<HTMLElement>(".paths");
    if (navStyle === "constellation" && seesaw) {
      const syncSeesawGeometry = () => {
        const ballWidth = Number.parseFloat(
          getComputedStyle(seesaw, "::after").width,
        );
        const ballRadius = ballWidth / 2;
        const halfBeamRun = seesaw.clientWidth * 0.195;
        const beamRise = Math.tan((19 * Math.PI) / 180) * halfBeamRun;

        seesaw.style.setProperty("--ball-low", `${beamRise - ballRadius}px`);
        seesaw.style.setProperty("--ball-high", `${-beamRise - ballRadius}px`);
      };

      syncSeesawGeometry();
      new ResizeObserver(syncSeesawGeometry).observe(seesaw);
      seesaw.classList.add("is-seesaw-active");
    }

    const landingSun = document.querySelector<HTMLElement>(".landing-sun");

    if (landingSun) {
      const positionSunlight = () => {
        const bounds = landingSun.getBoundingClientRect();
        document.body.style.setProperty("--sun-x", `${bounds.left + bounds.width / 2}px`);
        document.body.style.setProperty(
          "--sun-y",
          `${bounds.top + window.scrollY + bounds.height / 2}px`,
        );
      };

      positionSunlight();
      window.addEventListener("resize", positionSunlight);
    }

    const typewriter = document.querySelector<HTMLElement>("[data-typewriter]");
    const typewriterOutput = document.querySelector<HTMLElement>("[data-typewriter-output]");

    if (typewriter && typewriterOutput && typewriter.dataset.typed !== "true") {
      const finalCopy = typewriter.dataset.copy ?? "";
      const prefix =
        "I'm on a quest to scale content systems for ";
      const firstDraft = `${prefix}product desi`;
      const replacement = "AI-forward product design.";
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const rhythm = [0, 7, -3, 10, -5, 4];
      const emphasizedTerms = Array.from(
        document.querySelectorAll<HTMLElement>(".lede .em"),
      );
      const emphasizeTerm = (index = 0) => {
        const term = emphasizedTerms[index];
        if (!term) return;

        term.classList.add("is-gently-active");
        window.setTimeout(() => {
          term.classList.remove("is-gently-active");
        }, 1860);

        window.setTimeout(() => {
          const nextIndex = (index + 1) % emphasizedTerms.length;
          if (nextIndex === 0) {
            window.setTimeout(() => emphasizeTerm(0), 3000);
          } else {
            emphasizeTerm(nextIndex);
          }
        }, 2280);
      };

      typewriter.dataset.typed = "true";
      typewriterOutput.classList.add("is-typing");

      if (reducedMotion) {
        typewriterOutput.textContent = finalCopy;
        typewriterOutput.classList.remove("is-typing");
      } else {
        const characterDelay = (character: string, index: number) => {
          if (character === ".") return 300;
          if (character === ",") return 175;
          if (character === " ") return 44;
          return 78 + rhythm[index % rhythm.length];
        };

        const typeText = (
          text: string,
          onComplete: () => void,
          startIndex = 0,
        ) => {
          let character = startIndex;
          let nextCharacterAt = performance.now();

          const typeNextCharacter = () => {
            const nextCharacter = text[character];
            character += 1;
            typewriterOutput.textContent = text.slice(0, character);

            if (character >= text.length) {
              onComplete();
              return;
            }

            nextCharacterAt += characterDelay(nextCharacter, character);
            window.setTimeout(
              typeNextCharacter,
              Math.max(0, nextCharacterAt - performance.now()),
            );
          };

          typeNextCharacter();
        };

        const deleteDraft = () => {
          let text = firstDraft;

          const deleteNextCharacter = () => {
            text = text.slice(0, -1);
            typewriterOutput.textContent = text;

            if (text.length === prefix.length) {
              window.setTimeout(
                () => typeText(`${prefix}${replacement}`, () => {
                  typewriterOutput.classList.remove("is-typing");
                  window.setTimeout(() => emphasizeTerm(0), 650);
                }, prefix.length),
                240,
              );
              return;
            }

            window.setTimeout(deleteNextCharacter, 45);
          };

          window.setTimeout(deleteNextCharacter, 550);
        };

        window.setTimeout(() => {
          typeText(firstDraft, deleteDraft);
        }, 220);
      }
    }
  </script>

  <style>
    /* Two type sizes only: a headline size and a body size.
       Hierarchy comes from weight and colour, not more sizes. */
    :global(body.home) {
      transition: background-color 420ms ease;
    }

    :global(body.home:has(.landing-sun:hover)),
    :global(body.home:has(.people-bloom:focus-visible .landing-sun)) {
      background-color: #ffffff;
      background-image: radial-gradient(
        circle at var(--sun-x, 50%) var(--sun-y, 22%),
        rgba(255, 216, 88, 0.7) 0%,
        rgba(255, 216, 88, 0.42) 42%,
        rgba(255, 216, 88, 0.14) 78%,
        rgba(255, 216, 88, 0) 100%
      );
    }

    .hero { position: relative; margin-bottom: 4.5rem; }
    .hero h1 { font-size: clamp(1.9rem, 4.5vw, 3rem); margin: 0.5rem 0 1.55rem; line-height: 1.15; }
    .subtitle {
      min-height: 3.8rem;
      font-size: 1.2rem; font-weight: 400;
      color: var(--ink); margin: 0 0 0.65rem; line-height: 1.55;
    }
    .subtitle-typed.is-typing::after {
      content: "";
      display: inline-block;
      width: 0.08em;
      height: 0.9em;
      margin-left: 0.08em;
      background: var(--red);
      vertical-align: -0.08em;
      animation: type-caret 700ms steps(1) infinite;
    }
    .subtitle .nowrap { white-space: nowrap; }
    .lede { font-size: calc(0.95rem + 0.5px); line-height: 1.7; }
    .lede .em {
      position: relative;
      color: var(--red);
      font-weight: 700;
      cursor: default;
    }

    .lede .em:hover,
    .lede .em:focus-visible,
    .lede .em.is-gently-active {
      color: var(--red);
      font-style: italic;
    }

    .lede .em:focus-visible {
      outline: 1px solid var(--red);
      outline-offset: 0.12em;
      border-radius: 0.08em;
    }

    .paths {
      --path-hover-bg: var(--green);
      --path-hover-title: #ffffff;
      --path-hover-copy: #ffe17a;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      background: var(--ink);
      border: 2px solid var(--ink);
    }
    .path {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      min-height: 130px;
      padding: 1.75rem 1.5rem;
      border: 0;
      background: var(--paper);
      transition: background 180ms ease, color 180ms ease, transform 180ms ease;
    }
    .path:hover {
      background: var(--path-hover-bg);
      color: var(--path-hover-title);
    }
    .path:hover .path-sub { color: var(--path-hover-copy); }
    .path:hover .path-title { color: var(--path-hover-title); }
    .path-title {
      font-size: 1.05rem;
      font-weight: 700;
      perspective: 300px;
    }
    .path-title .coin-letter {
      display: inline-block;
      color: var(--green);
      transform-origin: center;
    }
    .path:hover .coin-letter {
      animation: coin-spin 1440ms cubic-bezier(0.3, 0.75, 0.3, 1);
    }
    .path-sub {
      color: var(--grey-600);
      font-size: calc(0.665rem - 0.35px);
      margin-top: auto;
    }
    .path-copy {
      display: grid;
      margin-top: auto;
    }
    .path-copy > * {
      grid-area: 1 / 1;
    }
    .path-cta {
      display: none;
    }

    :global(html[data-home-nav="branches"]) .paths {
      position: relative;
      grid-template-columns: 1fr;
      gap: 0;
      border: 0;
      background: transparent;
      padding-left: 2.6rem;
    }
    :global(html[data-home-nav="branches"]) .paths::before {
      content: "";
      position: absolute;
      left: 0.8rem;
      top: 0.8rem;
      bottom: 0.8rem;
      border-left: 2px solid var(--green);
    }
    :global(html[data-home-nav="branches"]) .path {
      min-height: 0;
      padding: 1.2rem 0.5rem 1.2rem 1rem;
      border: 0;
      border-bottom: 1px solid var(--grey-200);
      background: transparent;
    }
    :global(html[data-home-nav="branches"]) .path::before {
      content: "❧";
      position: absolute;
      left: -2.45rem;
      top: 50%;
      color: var(--green);
      font-size: 1.45rem;
      transform: translateY(-50%);
    }
    :global(html[data-home-nav="branches"]) .path:hover {
      color: var(--ink);
      background: transparent;
      transform: translateX(0.45rem);
    }
    :global(html[data-home-nav="branches"]) .path:hover .path-title {
      color: var(--ink);
    }
    :global(html[data-home-nav="branches"]) .path:hover .path-sub {
      color: var(--green);
    }

    :global(html[data-home-nav="editorial"]) .paths {
      gap: 2rem;
      border: 0;
      background: transparent;
    }
    :global(html[data-home-nav="editorial"]) .path {
      min-height: 125px;
      padding: 1rem 0 1.2rem;
      border: 0;
      border-top: 2px solid var(--green);
      border-bottom: 1px solid var(--grey-200);
      background: transparent;
    }
    :global(html[data-home-nav="editorial"]) .path::before {
      content: attr(data-index);
      color: var(--red);
      font-size: 0.7rem;
      letter-spacing: 0.14em;
    }
    :global(html[data-home-nav="editorial"]) .path:hover {
      color: var(--ink);
      background: transparent;
      transform: translateY(-0.25rem);
    }
    :global(html[data-home-nav="editorial"]) .path:hover .path-title {
      color: var(--ink);
    }
    :global(html[data-home-nav="editorial"]) .path:hover .path-sub {
      color: var(--green);
    }

    :global(html[data-home-nav="growth"]) .paths {
      position: relative;
      gap: 3rem;
      border: 0;
      background: transparent;
    }
    :global(html[data-home-nav="growth"]) .paths::before {
      content: "";
      position: absolute;
      left: 12%;
      right: 12%;
      top: 50%;
      border-top: 1px solid var(--green);
    }
    :global(html[data-home-nav="growth"]) .path {
      min-height: 130px;
      padding: 1.25rem 1rem 1.25rem 4.8rem;
      border: 0;
      background: var(--paper);
    }
    :global(html[data-home-nav="growth"]) .path::before {
      content: "";
      position: absolute;
      left: 1.25rem;
      top: 50%;
      width: 2.2rem;
      height: 3rem;
      border: 2px solid var(--green);
      border-radius: 100% 0 100% 0;
      background: var(--paper);
      transform: translateY(-50%) rotate(-45deg);
    }
    :global(html[data-home-nav="growth"]) .path:nth-child(2)::before {
      border-radius: 0 100% 0 100%;
      transform: translateY(-50%) rotate(45deg);
    }
    :global(html[data-home-nav="growth"]) .path:hover {
      color: var(--ink);
      background: var(--paper);
      transform: translateY(-0.2rem);
    }
    :global(html[data-home-nav="growth"]) .path:hover .path-title {
      color: var(--ink);
    }
    :global(html[data-home-nav="growth"]) .path:hover .path-sub {
      color: var(--green);
    }

    :global(html[data-home-nav="constellation"]) .paths {
      position: relative;
      grid-template-columns: 39% 39%;
      justify-content: center;
      gap: 0;
      padding: 2.3rem 1rem 1.8rem;
      border: 0;
      background: transparent;
    }
    :global(html[data-home-nav="constellation"]) .paths::before {
      content: "";
      position: absolute;
      left: 30.5%;
      right: 30.5%;
      top: 2.8rem;
      border-top: 1px dashed var(--green);
      transform-origin: center;
      will-change: transform;
    }
    :global(html[data-home-nav="constellation"]) .path {
      min-height: 120px;
      align-items: center;
      justify-content: center;
      gap: 0;
      padding: 1.3rem 0.75rem;
      border: 0;
      background: transparent;
      text-align: center;
      transform-origin: center top;
      will-change: transform;
    }
    :global(html[data-home-nav="constellation"]) .path-sub {
      position: absolute;
      z-index: 4;
      left: 50%;
      bottom: calc(100% + 0.6rem);
      width: min(20rem, 86%);
      padding: 0.55rem 0.7rem;
      border: 0;
      border-radius: 10px;
      background: var(--green-soft);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.24);
      color: var(--green);
      font-size: 0.82rem;
      line-height: 1.45;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translate(-50%, 0.25rem);
      transition: opacity 180ms ease, transform 180ms ease;
    }
    :global(html[data-home-nav="constellation"]) .path-cta {
      display: block;
      color: var(--red);
      width: fit-content;
      margin: 0 auto;
      border-bottom: 1px solid currentColor;
      font-size: calc(0.66rem + 5px);
      font-style: italic;
      line-height: 1.15;
      opacity: 1;
    }
    :global(html[data-home-nav="constellation"]) .path-copy {
      margin-top: -0.2rem;
    }
    :global(html[data-home-nav="constellation"]) .path:hover .path-sub,
    :global(html[data-home-nav="constellation"]) .path:focus-visible .path-sub {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
    }
    :global(html[data-home-nav="constellation"]) .paths::after {
      content: "";
      position: absolute;
      left: calc(30.5% - 0.35rem);
      top: calc(2.8rem - 0.35rem);
      width: 0.7rem;
      height: 0.7rem;
      border: 2px solid var(--red);
      border-radius: 50%;
      background: var(--paper);
      will-change: left, transform, opacity;
    }
    :global(html[data-home-nav="constellation"]) .paths.is-seesaw-active::before {
      animation: seesaw-rock 15150ms ease-in-out infinite;
    }
    :global(html[data-home-nav="constellation"]) .paths.is-seesaw-active::after {
      animation: seesaw-ball 15150ms linear infinite;
    }
    :global(html[data-home-nav="constellation"]) .paths.is-seesaw-active .path:first-child {
      animation: seesaw-left-label 15150ms ease-in-out infinite;
    }
    :global(html[data-home-nav="constellation"]) .paths.is-seesaw-active .path:nth-child(2) {
      animation: seesaw-right-label 15150ms ease-in-out infinite;
    }
    :global(html[data-home-nav="constellation"]) .paths.is-seesaw-active:has(.path:hover)::before,
    :global(html[data-home-nav="constellation"]) .paths.is-seesaw-active:has(.path:hover)::after,
    :global(html[data-home-nav="constellation"]) .paths.is-seesaw-active:has(.path:hover) .path,
    :global(html[data-home-nav="constellation"]) .paths.is-seesaw-active:focus-within::before,
    :global(html[data-home-nav="constellation"]) .paths.is-seesaw-active:focus-within::after,
    :global(html[data-home-nav="constellation"]) .paths.is-seesaw-active:focus-within .path {
      animation-play-state: paused;
    }
    :global(html[data-home-nav="constellation"]) .path:hover {
      color: var(--ink);
      background: transparent;
      transform: scale(1.025);
    }
    :global(html[data-home-nav="constellation"]) .path:hover .path-title {
      color: var(--ink);
    }
    :global(html[data-home-nav="constellation"]) .path:hover .path-sub {
      color: var(--green);
    }

    :global(html[data-home-nav="constellation"][data-seesaw-container="pans"]) .path {
      min-height: 88px;
      padding: 0.8rem 0.65rem;
      border-right: 1px solid var(--green);
      border-bottom: 1px solid var(--green);
      border-left: 1px solid var(--green);
      background: var(--paper);
    }
    :global(html[data-home-nav="constellation"][data-seesaw-container="pans"]) .path::before {
      content: "";
      position: absolute;
      left: 50%;
      bottom: 100%;
      height: 1.05rem;
      border-left: 1px solid var(--green);
    }

    :global(html[data-home-nav="constellation"][data-seesaw-container="placards"]) .path {
      min-height: 88px;
      padding: 0.8rem 0.65rem;
      border: 0;
      background: transparent;
      box-shadow: none;
    }
    :global(html[data-home-nav="constellation"][data-seesaw-container="placards"]) .path::before,
    :global(html[data-home-nav="constellation"][data-seesaw-container="placards"]) .path::after {
      display: none;
    }

    :global(html[data-home-nav="sentences"]) .paths {
      grid-template-columns: 1fr;
      gap: 0;
      border: 0;
      background: transparent;
    }
    :global(html[data-home-nav="sentences"]) .path {
      display: grid;
      grid-template-columns: minmax(8rem, 0.35fr) 1fr auto;
      min-height: 0;
      align-items: baseline;
      gap: 1rem;
      padding: 1.25rem 0.4rem;
      border: 0;
      border-bottom: 1px solid var(--grey-200);
      background: transparent;
    }
    :global(html[data-home-nav="sentences"]) .path:first-child {
      border-top: 1px solid var(--grey-200);
    }
    :global(html[data-home-nav="sentences"]) .path-title::after {
      content: ":";
      color: var(--red);
    }
    :global(html[data-home-nav="sentences"]) .path::after {
      content: "↗";
      color: var(--red);
    }
    :global(html[data-home-nav="sentences"]) .path:hover {
      color: var(--ink);
      background: var(--green-soft);
      transform: none;
    }
    :global(html[data-home-nav="sentences"]) .path:hover .path-title {
      color: var(--ink);
    }
    :global(html[data-home-nav="sentences"]) .path:hover .path-sub {
      color: var(--grey-600);
    }

    @keyframes coin-spin {
      0% { transform: rotateY(0deg); }
      45% { transform: rotateY(170deg) scaleX(0.82); }
      100% { transform: rotateY(360deg); }
    }

    @keyframes seesaw-rock {
      0% { transform: rotate(-19deg); }
      10%, 50% { transform: rotate(19deg); }
      60%, 100% { transform: rotate(-19deg); }
    }

    @keyframes seesaw-ball {
      0% {
        left: calc(30.5% - 0.35rem);
        transform: translateY(var(--ball-low, 2.9rem)) rotate(-720deg);
        animation-timing-function: ease-in-out;
      }
      10% {
        left: calc(30.5% - 0.35rem);
        transform: translateY(var(--ball-high, -3.6rem)) rotate(-720deg);
        animation-timing-function: ease-in-out;
      }
      50% {
        left: calc(69.5% - 0.35rem);
        transform: translateY(var(--ball-low, 2.9rem)) rotate(0deg);
        animation-timing-function: ease-in-out;
      }
      60% {
        left: calc(69.5% - 0.35rem);
        transform: translateY(var(--ball-high, -3.6rem)) rotate(0deg);
        animation-timing-function: ease-in-out;
      }
      100% {
        left: calc(30.5% - 0.35rem);
        transform: translateY(var(--ball-low, 2.9rem)) rotate(-720deg);
      }
    }

    @keyframes seesaw-left-label {
      0% { transform: translateY(3.4rem); }
      10%, 50% { transform: translateY(-3.4rem); }
      60%, 100% { transform: translateY(3.4rem); }
    }

    @keyframes seesaw-right-label {
      0% { transform: translateY(-3.4rem); }
      10%, 50% { transform: translateY(3.4rem); }
      60%, 100% { transform: translateY(-3.4rem); }
    }

    @media (max-width: 640px) {
      .paths { grid-template-columns: 1fr; }
    }

    .skills-note {
      position: relative;
      isolation: isolate;
      margin: 1.5rem 0 0;
      padding: 2.5rem 1rem 1rem;
      text-align: center;
      color: var(--ink);
      font-size: calc(1.05rem - 0.5px);
    }
    .skills-note::before {
      content: "";
      position: absolute;
      z-index: -1;
      inset: 0;
      background: var(--green-soft);
      clip-path: polygon(
        0 34%, 2% 20%, 3% 34%, 5% 14%, 6% 35%, 8% 24%, 10% 36%,
        12% 18%, 14% 35%, 16% 12%, 18% 34%, 20% 22%, 23% 36%,
        25% 15%, 27% 34%, 30% 20%, 32% 36%, 35% 13%, 37% 35%,
        40% 22%, 43% 36%, 46% 16%, 48% 35%, 51% 21%, 54% 36%,
        57% 14%, 60% 35%, 63% 20%, 66% 36%, 69% 12%, 72% 35%,
