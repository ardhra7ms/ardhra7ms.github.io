---
import Base from "../layouts/Base.astro";
import PeopleBloom from "../components/PeopleBloom.astro";
---
<Base bg bodyClass="home">
  <section class="hero">
    <p class="kicker"><span class="ink">Content Designer</span> → Content Strategist</p>
    <h1>
      I make products talk the way <PeopleBloom sunflower /> do.
    </h1>
    <p class="subtitle">
      People are dynamic, and so is language. I'm on a quest to scale content design to elevate <span class="nowrap">AI-forward</span> product design.
    </p>
    <p class="muted lede">
      I'm a writer, artist, and lover of languages, trained in communications, digital media, and engineering. I build <span class="em" tabindex="0">content systems</span> that scale across complex product ecosystems by establishing <span class="em" tabindex="0">terminology</span>, defining <span class="em" tabindex="0">objects</span> and <span class="em" tabindex="0">relationships</span>, and mapping them to product truth.<span class="cursor" aria-hidden="true"></span>
    </p>
  </section>

  <section class="paths">
    <a class="path" href="/story">
      <span class="path-title">H<span class="o">o</span>w I see</span>
      <span class="path-sub">The stories that shape me and how I make sense of the world.</span>
    </a>
    <a class="path" href="/work">
      <span class="path-title">What I d<span class="o">o</span></span>
      <span class="path-sub">Where work leads to passion and inspiration finds me.</span>
    </a>
  </section>

  <p class="skills-note">
    <svg class="fly" viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="15" rx="3.2" ry="4.2"/><path d="M12 12C10 8 7 6 4 7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M12 12C14 8 17 6 20 7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>A person is a growing tree, and <a href="/skills">skills</a> guiding fireflies.
  </p>

  <script>
    const landingSun = document.querySelector<HTMLElement>(".landing-sun");

    if (landingSun) {
      const positionSunlight = () => {
        const bounds = landingSun.getBoundingClientRect();
        document.body.style.setProperty("--sun-x", `${bounds.left + bounds.width / 2}px`);
        document.body.style.setProperty(
          "--sun-y",
          `${bounds.top + window.scrollY + bounds.height / 2}px`,
        );
      };

      positionSunlight();
      window.addEventListener("resize", positionSunlight);
    }
  </script>

  <style>
    /* Two type sizes only: a headline size and a body size.
       Hierarchy comes from weight and colour, not more sizes. */
    :global(body.home) {
      transition: background-color 420ms ease;
    }

    :global(body.home:has(.landing-sun:hover)),
    :global(body.home:has(.people-bloom:focus-visible .landing-sun)) {
      background-color: #ffffff;
      background-image: radial-gradient(
        circle at var(--sun-x, 50%) var(--sun-y, 22%),
        rgba(255, 216, 88, 0.7) 0%,
        rgba(255, 216, 88, 0.42) 42%,
        rgba(255, 216, 88, 0.14) 78%,
        rgba(255, 216, 88, 0) 100%
      );
    }

    .hero { position: relative; margin-bottom: 4.5rem; }
    .hero h1 { font-size: clamp(1.9rem, 4.5vw, 3rem); margin: 0.5rem 0 1.25rem; line-height: 1.15; }
    .subtitle {
      font-size: 1.2rem; font-weight: 400;
      color: var(--ink); margin: 0 0 1.5rem; line-height: 1.55;
    }
    .subtitle .nowrap { white-space: nowrap; }
    .lede { font-size: 0.95rem; line-height: 1.7; }
    .lede .em {
      position: relative;
      color: var(--red);
      font-weight: 700;
      cursor: default;
    }

    .lede .em:hover,
    .lede .em:focus-visible {
      color: var(--red);
      font-style: italic;
    }

    .lede .em:focus-visible {
      outline: 1px solid var(--red);
      outline-offset: 0.12em;
      border-radius: 0.08em;
    }

    .paths { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--ink); border: 2px solid var(--ink); }
    .path {
      background: var(--paper); padding: 1.75rem 1.5rem; border: 0;
      display: flex; flex-direction: column; gap: 0.4rem; min-height: 130px;
    }
    .path:hover { background: var(--ink); color: var(--paper); }
    .path:hover .path-sub { color: var(--paper); }
    .path:hover .path-title { color: var(--green-apple); }
    .path-title { font-size: 1.05rem; font-weight: 700; }
    .path-title .o { color: var(--green); }
    .path:hover .path-title .o { color: var(--green-apple); }
    .path-sub { color: var(--grey-600); font-size: 1.05rem; margin-top: auto; }

    @media (max-width: 640px) {
      .paths { grid-template-columns: 1fr; }
    }

    .skills-note {
      margin-top: 1.5rem; text-align: left;
      color: var(--ink);
      font-size: 1.05rem;
    }
    .skills-note .fly {
      width: 1.05em; height: 1.05em; display: inline-block;
      color: var(--ink); fill: var(--ink);
      margin-right: 0.4em; vertical-align: -0.18em;
    }
    .skills-note a { color: var(--green); text-decoration: underline; border: 0; }
    .skills-note a:hover { color: var(--red); }
  </style>
</Base>
