---
import Base from "../../layouts/Base.astro";

// Fireflies carry strengths. Edit this list freely — these are seeded from
// your material and meant to be replaced with your own words.
// x / y are % positions on the night canvas; dur/delay tune the drift.
const strengths = [
  { text: "Object-oriented UX",     x: 12, y: 8,  mx: 44, my: 5,  dur: 15, delay: 0,   blurb: "Designing content as a system of objects and relationships, not just isolated screens.", href: "/work/dsi" },
  { text: "Terminology",            x: 60, y: 9,  mx: 55, my: 8,  dur: 18, delay: 1.5, blurb: "Building shared vocabularies so a product's core terms mean the same thing everywhere.", href: "/work/ediscovery" },
  { text: "Concept mapping",        x: 36, y: 13, mx: 45, my: 12, dur: 16, delay: 3,   blurb: "Mapping how concepts relate, so meaning stays coherent across a whole experience.", href: "/work/dsi" },
  { text: "Vibe coding",            x: 76, y: 15, mx: 35, my: 15, dur: 20, delay: 2,   blurb: "Prototyping and building with AI, turning rough ideas into working things fast.", href: "/work/neur-xr" },
  { text: "AI content systems",     x: 16, y: 18, mx: 44, my: 18, dur: 19, delay: 0.8, blurb: "Designing how AI speaks, and the guardrails that keep it clear and honest.", href: "/work/harms-overreliance" },
  { text: "User Experience Design", x: 46, y: 21, mx: 44, my: 21, dur: 21, delay: 3.6, blurb: "Shaping end-to-end flows so a product feels intuitive, human, and easy to move through.", href: "/work/ather-careers" },
  { text: "Content Design",         x: 70, y: 24, mx: 48, my: 25, dur: 16, delay: 2.4, blurb: "Words, structure, and guidance that help people move through a product with ease.", href: "/work/ediscovery" },
  { text: "Writing",                x: 26, y: 28, mx: 35, my: 28, dur: 18, delay: 5,   blurb: "Where my love of language began, from poetry to product.", href: "/projects/magazine-essay" },
  { text: "Product development",    x: 56, y: 30, mx: 44, my: 31, dur: 15, delay: 3.2, blurb: "Partnering from envisioning to launch, owning the content end to end.", href: "/work/dsi" },
  { text: "Responsible AI",         x: 80, y: 34, mx: 48, my: 34, dur: 18, delay: 0.4, blurb: "Messaging that keeps people oriented and reduces overreliance on AI.", href: "/work/harms-overreliance" },
  { text: "Accessibility",          x: 14, y: 37, mx: 52, my: 38, dur: 17, delay: 2.8, blurb: "Auditing and designing so experiences work well for everyone.", href: "/work/nike-accessibility" },
  { text: "Critical thinking",      x: 42, y: 40, mx: 45, my: 41, dur: 19, delay: 4.4, blurb: "Asking the hard questions to find the real problem beneath the ask.", href: "/work/dsi" },
  { text: "User research",          x: 66, y: 44, mx: 45, my: 45, dur: 16, delay: 1.8, blurb: "Listening closely to understand how people think, work, and struggle.", href: "/work/neur-xr" },
  { text: "Art",                    x: 24, y: 48, mx: 35, my: 48, dur: 21, delay: 3.8, blurb: "Drawing and painting, where I think with my hands and see differently.", href: "/projects/rome-brand" },
  { text: "Music",                  x: 52, y: 51, mx: 55, my: 51, dur: 15, delay: 0.6, blurb: "A lifelong thread that tunes how I hear rhythm and voice.", href: "/story" },
  { text: "Communications",         x: 34, y: 55, mx: 45, my: 54, dur: 17, delay: 1.4, blurb: "Trained across communications, digital media, and engineering, connecting people and ideas.", href: "/projects/stumbling-upon-rome" },
  { text: "Storytelling",           x: 72, y: 58, mx: 48, my: 58, dur: 19, delay: 3.4, blurb: "Every good product, like every good essay, tells one coherent story.", href: "/projects/stumbling-upon-rome" },
];
---
<Base bodyClass="dark">
  <section class="skills-intro">
    <p class="kicker">The skill tree</p>
    <h1>Strengths, as <span class="red">fireflies</span>.</h1>
    <p class="muted">
      Each light carries something I bring. Hover or tab through them and they'll glow. <span class="cursor" aria-hidden="true"></span>
    </p>
  </section>

  <section class="night" aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="sr-only">My strengths</h2>
    <ul class="fireflies" aria-label="Strengths">
      {strengths.map((s) => (
        <li
          class:list={["firefly", { "flip-x": s.x > 52, "flip-y": s.y > 66 }]}
          tabindex="0"
          style={`--x:${s.x}%; --y:${s.y}%; --mx:${s.mx}%; --my:${s.my}%; --dur:${s.dur}s; --delay:${s.delay}s;`}
        >
          <span class="glow" aria-hidden="true"></span>
          <span class="label">{s.text}</span>
          <div class="card" role="group" aria-label={s.text}>
            <p class="card-text">{s.blurb}</p>
            <a class="card-link" href={s.href}>See it &rarr;</a>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <style>
    .skills-intro { margin-bottom: 2rem; }
    .skills-intro h1 { font-size: clamp(1.8rem, 4.5vw, 3rem); margin: 0.5rem 0 1rem; }

    /* Full-bleed night canvas inside the centred wrap */
    .night {
      position: relative;
      left: 50%; right: 50%;
      margin-left: -50vw; margin-right: -50vw;
      width: 100vw;
      min-height: 92vh;
      overflow: hidden;
      background:
        radial-gradient(120% 90% at 50% 10%, #16211a 0%, #0d130f 55%, #080b09 100%);
      border-top: 1px solid #223027;
      border-bottom: 1px solid #223027;
    }

    .fireflies {
      position: absolute; inset: 0;
      list-style: none; margin: 0; padding: 0;
    }

    .firefly {
      position: absolute;
      left: var(--x); top: var(--y);
      display: inline-flex; align-items: center; gap: 0.55rem;
      transform: translate(-50%, -50%);
      cursor: default;
      animation: drift var(--dur, 18s) ease-in-out var(--delay, 0s) infinite alternate;
      outline: none;
    }

    .glow {
      position: relative;
      flex: 0 0 auto;
      width: 9px; height: 9px; border-radius: 50%;
      background: var(--green-apple);
      box-shadow: 0 0 6px 2px rgba(143, 203, 94, 0.55);
      animation: pulse calc(var(--dur, 18s) / 4) ease-in-out infinite;
    }

    /* Two light-line wings — no fill; the glow supplies the light. */
    .glow::before,
    .glow::after {
      content: "";
      position: absolute;
      top: 50%;
      width: 9px; height: 12px;
      border: 1px solid rgba(201, 245, 154, 0.45);
      border-radius: 50%;
      background: transparent;
      pointer-events: none;
      transition: border-color 0.25s ease;
    }
    .glow::before { left: 50%; transform: translate(-95%, -55%) rotate(-24deg); }
    .glow::after  { left: 50%; transform: translate(-5%, -55%) rotate(24deg); }

    .firefly:hover .glow::before,
    .firefly:focus-visible .glow::before,
    .firefly:hover .glow::after,
    .firefly:focus-visible .glow::after {
      border-color: rgba(201, 245, 154, 0.85);
    }

    .label {
      color: #d8e6cc;
      font-size: 0.9rem;
      letter-spacing: 0.02em;
      white-space: nowrap;
      opacity: 0.55;
      transition: opacity 0.25s ease, color 0.25s ease, text-shadow 0.25s ease;
    }

    .firefly:hover .glow,
    .firefly:focus-visible .glow {
      background: #c9f59a;
      box-shadow: 0 0 14px 5px rgba(143, 203, 94, 0.85);
    }
    .firefly:hover .label,
    .firefly:focus-visible .label {
      opacity: 1;
      color: #f0f8e8;
      text-shadow: 0 0 10px rgba(143, 203, 94, 0.5);
    }
    .firefly:focus-visible {
      outline: 2px solid var(--green-apple);
      outline-offset: 6px;
      border-radius: 4px;
    }

    /* Pop-up card — light green, dark text for contrast. */
    .card {
      position: absolute;
      top: calc(100% + 12px);
      left: -4px;
      width: 220px;
      background: #cdefab;
      color: #14210d;
      border-radius: 10px;
      padding: 0.7rem 0.85rem;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
      opacity: 0;
      visibility: hidden;
      transform: translateY(4px);
      transition: opacity 0.2s ease, transform 0.2s ease;
      pointer-events: none;
      z-index: 5;
    }
    .card-text {
      margin: 0 0 0.5rem;
      font-size: 0.82rem;
      line-height: 1.45;
    }
    .card-link {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 700;
      color: #2f6a1e;
      text-decoration: none;
      white-space: nowrap;
    }
    .card-link:hover,
    .card-link:focus-visible { text-decoration: underline; }

    /* Flip the card away from the canvas edges. */
    .firefly.flip-x .card { left: auto; right: calc(100% - 14px); }
    .firefly.flip-y .card { top: auto; bottom: calc(100% + 12px); transform: translateY(-4px); }

    .firefly:hover,
    .firefly:focus-within { z-index: 20; animation-play-state: paused; }

    .firefly:hover .card,
    .firefly:focus-within .card {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }

    @keyframes drift {
      0%   { transform: translate(-50%, -50%); }
      50%  { transform: translate(calc(-50% + 14px), calc(-50% - 12px)); }
      100% { transform: translate(calc(-50% - 10px), calc(-50% + 10px)); }
    }
    @keyframes pulse {
      0%, 100% { opacity: 0.45; }
      50%      { opacity: 1; }
    }

    @media (prefers-reduced-motion: reduce) {
      .firefly { animation: none; }
      .glow { animation: none; opacity: 1; }
      .label { opacity: 1; }   /* all strengths readable when motion is off */
    }

    @media (max-width: 640px) {
      .label { font-size: 0.82rem; }
      .night { min-height: 82vh; }
      /* Phone-tuned positions keep each firefly's whole label on-screen
         (centre-anchored, so nothing clips off either edge). */
      .firefly { left: var(--mx); top: var(--my); }
      /* Centre cards under the dot so they never overflow a narrow screen. */
      .card,
      .firefly.flip-x .card { left: 50%; right: auto; width: 200px; margin-left: -100px; }
    }
  </style>
</Base>
